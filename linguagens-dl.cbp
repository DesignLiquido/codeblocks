<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="linguagens-dl" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />

        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/linguagens-dl" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="3" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-Wall" />
                    <Add option="-std=gnu++17" />
                    <Add option="-g" />
                </Compiler>
                <Linker>
                    <Add library="codeblocks" />
                </Linker>
            </Target>

            <Target title="Release">
                <Option output="bin/Release/linguagens-dl" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="3" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-Wall" />
                    <Add option="-std=gnu++17" />
                    <Add option="-O2" />
                </Compiler>
                <Linker>
                    <Add library="codeblocks" />
                </Linker>
            </Target>
        </Build>

        <Compiler>
            <Add directory="$(CBSDK)/include" />
            <Add directory="$(WXWIN)/include" />
        </Compiler>

        <Linker>
            <Add directory="$(CBSDK)/lib" />
            <Add directory="$(WXWIN)/lib" />
        </Linker>

        <Unit filename="fontes/plugin.h" />
        <Unit filename="fontes/plugin.cpp" />
        <Unit filename="fontes/completion.h" />
        <Unit filename="fontes/completion.cpp" />
        <Unit filename="fontes/manager.h" />
        <Unit filename="fontes/manager.cpp" />
        <Unit filename="fontes/runner.h" />
        <Unit filename="fontes/runner.cpp" />
        <Unit filename="recursos/manifest.xml" />

        <Extensions>
            <code_completion />
            <envvars />
        </Extensions>
    </Project>
</CodeBlocks_project_file>
