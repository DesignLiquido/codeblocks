<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="LinguagensDL" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />

        <Build>
            <Target title="Debug">
                <Option output="bin/Debug/LinguagensDL" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="3" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-Wall" />
                    <Add option="-std=gnu++17" />
                    <Add option="-g" />
                </Compiler>
            </Target>

            <Target title="Release">
                <Option output="bin/Release/LinguagensDL" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="3" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-Wall" />
                    <Add option="-std=gnu++17" />
                    <Add option="-O2" />
                </Compiler>
            </Target>
        </Build>

        <Compiler>
            <Add option="-D__WXMSW__" />
            <Add option="-DwxUSE_UNICODE=1" />
            <Add option="-include cstdint" />
            <Add directory="fontes" />
            <Add directory="cbsdk-include" />
            <Add directory="cbsdk-include/tinyxml" />
            <Add directory="sdk/wxscintilla/include" />
            <Add directory="C:/msys64/ucrt64/lib/wx/include/msw-unicode-3.2" />
            <Add directory="C:/msys64/ucrt64/include/wx-3.2" />
        </Compiler>

        <Linker>
            <Add directory="C:/msys64/ucrt64/lib" />
            <Add library="wx_mswu_core-3.2" />
            <Add library="wx_baseu-3.2" />
            <Add library="wx_baseu_xml-3.2" />
            <Add library="wx_mswu_aui-3.2" />
            <Add library="wx_mswu_xrc-3.2" />
            <Add library="wxscintilla-3.2" />
            <Add library="codeblocks" />
        </Linker>

        <Unit filename="fontes/plugin.h" />
        <Unit filename="fontes/plugin.cpp" />
        <Unit filename="fontes/completion.h" />
        <Unit filename="fontes/completion.cpp" />
        <Unit filename="fontes/debugger_bridge.h" />
        <Unit filename="fontes/debugger_bridge.cpp" />
        <Unit filename="fontes/manager.h" />
        <Unit filename="fontes/manager.cpp" />
        <Unit filename="fontes/runner.h" />
        <Unit filename="fontes/runner.cpp" />
        <Unit filename="recursos/manifest.xml" />

        <Extensions>
            <code_completion />
            <envvars />
        </Extensions>
    </Project>
</CodeBlocks_project_file>
